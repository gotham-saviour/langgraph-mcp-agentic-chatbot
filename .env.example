# =====================================================================
# LangGraph MCP Agentic Chatbot - Environment Configuration Template
# Copy this file to '.env' and populate with your own API credentials.
# =====================================================================

# 1. Google Gemini API Key (Required)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Model Selection (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 3. AlphaVantage Market Data API Key (Required for real-time stock prices MCP)
# Claim a free API key at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# 4. Checkpointer Database File (Optional, defaults to ./chatbot.db)
DATABASE_PATH=chatbot.db

# 5. LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=LangGraph-MCP-Agent
